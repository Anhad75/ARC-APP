# Auth.js requires a random secret with at least 32 characters.
AUTH_SECRET=replace-with-a-random-32-character-secret

# For MongoDB Compass running a local MongoDB server, use:
MONGODB_URI=mongodb://localhost:27017
# For deployment, replace MONGODB_URI with your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=field-notes

AUTH_URL=http://localhost:3001

# Frontend origin used by the auth server.
CLIENT_ORIGIN=http://localhost:5173
PORT=3001

